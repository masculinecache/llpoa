# LLPOA Bylaw Search Configuration
#
# 1. Publish your Google Doc: File > Share > Publish to web
# 2. Copy the document ID from the URL:
#    https://docs.google.com/document/d/{GOOGLE_DOC_ID}/edit
# 3. Set it here:

GOOGLE_DOC_ID=

# Optional: Google API Key for Docs API access.
# Only needed if the doc is NOT published to the web.
GOOGLE_API_KEY=

# OpenRouter API Key for AI Q&A mode.
# Get one at https://openrouter.ai/keys — free tier works with free models.
OPENROUTER_API_KEY=

# Sentry DSN for error tracking (optional).
SENTRY_DSN=

# Sentry OTLP tracing (optional). Required together with SENTRY_DSN to enable
# Sentry OTLP tracing: host:port ingest endpoint, org id, and public key.
SENTRY_OTLP_HOST=
SENTRY_ORG_ID=
SENTRY_PUBLIC_KEY=

# Public host served behind the proxy (sets X-Forwarded-Host in docker-compose).
PUBLIC_HOST=

# PostHog API Key for session replay, error tracking, AI observability, and product analytics.
POSTHOG_KEY=

# Comma-separated Google Drive file IDs for bylaw documents (optional).
# Example: GDRIVE_FILE_IDS=id1,id2,id3
GDRIVE_FILE_IDS=

# LegiScan API key for live Michigan state legislative bill tracking (optional).
# When set, bills for the current session are fetched on startup and indexed
# alongside the local corpus under the "state" domain. Get one at
# https://legiscan.com/ (Data Access -> Sign up for free API key).
LEGISCAN_API_KEY=
# LegiScan state abbreviation to track (default: MI). Used only when LEGISCAN_API_KEY is set.
LEGISCAN_STATE=
# Optional LegiScan session id to pin. Leave empty to auto-track the current
# active session (e.g. Michigan's 2025-2026 regular session).
LEGISCAN_SESSION_ID=
